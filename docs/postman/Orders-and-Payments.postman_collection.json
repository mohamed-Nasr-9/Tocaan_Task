{
  "info": {
    "_postman_id": "80c66547-9a76-45d5-8f20-21318c9a8944",
    "name": "Orders and Payments API",
    "description": "JWT-authenticated order management and local-only simulated payment attempts. Set base_url using the provided environment. Register once, then use Login on later runs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/register",
            "description": "Creates a user and stores the returned JWT in the environment. Set a unique email and a local password first."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  pm.environment.set('token', pm.response.json().access_token);", "}"] } }],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/login",
            "description": "Signs in and saves access_token to the token environment variable."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  pm.environment.set('token', pm.response.json().access_token);", "}"] } }],
          "response": [{ "name": "401 invalid credentials", "originalRequest": { "method": "POST", "url": "{{base_url}}/auth/login" }, "status": "Unauthorized", "code": 401, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"message\": \"The provided credentials are incorrect.\"\n}" }]
        },
        {
          "name": "Current user",
          "request": { "method": "GET", "url": "{{base_url}}/auth/me" },
          "response": [{ "name": "401 missing or invalid token", "originalRequest": { "method": "GET", "url": "{{base_url}}/auth/me" }, "status": "Unauthorized", "code": 401, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"message\": \"Unauthenticated.\"\n}" }]
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{base_url}}/auth/logout" },
          "response": []
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customer_name\": \"Alex Example\",\n  \"customer_email\": \"alex@example.com\",\n  \"customer_phone\": \"+1 555 0100\",\n  \"items\": [\n    {\"product_name\": \"Coffee\", \"quantity\": 2, \"price\": \"12.34\"},\n    {\"product_name\": \"Tea\", \"quantity\": 1, \"price\": \"5.34\"}\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/orders",
            "description": "Stores the server-calculated order total. Saves data.id as order_id."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  pm.environment.set('order_id', pm.response.json().data.id);", "}"] } }],
          "response": [{ "name": "201 order created", "originalRequest": { "method": "POST", "url": "{{base_url}}/orders" }, "status": "Created", "code": 201, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"data\": {\n    \"id\": 17,\n    \"customer\": {\"name\": \"Alex Example\", \"email\": \"alex@example.com\", \"phone\": \"+1 555 0100\"},\n    \"status\": \"pending\",\n    \"total\": \"30.02\",\n    \"currency\": \"USD\",\n    \"items\": [\n      {\"id\": 23, \"product_name\": \"Coffee\", \"quantity\": 2, \"unit_price\": \"12.34\", \"line_total\": \"24.68\"},\n      {\"id\": 24, \"product_name\": \"Tea\", \"quantity\": 1, \"unit_price\": \"5.34\", \"line_total\": \"5.34\"}\n    ]\n  }\n}" }]
        },
        {
          "name": "List my orders",
          "request": { "method": "GET", "url": "{{base_url}}/orders?per_page=15" },
          "response": []
        },
        {
          "name": "Filter pending orders",
          "request": { "method": "GET", "url": "{{base_url}}/orders?status=pending&per_page=15" },
          "response": []
        },
        {
          "name": "Get order",
          "request": { "method": "GET", "url": "{{base_url}}/orders/{{order_id}}" },
          "response": []
        },
        {
          "name": "Confirm order",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"confirmed\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/orders/{{order_id}}"
          },
          "response": []
        },
        {
          "name": "Delete order (only with no payment history)",
          "request": { "method": "DELETE", "url": "{{base_url}}/orders/{{order_id}}", "description": "Optional: run only for an order that has no payment attempts." },
          "response": [{ "name": "422 order has payment history", "originalRequest": { "method": "DELETE", "url": "{{base_url}}/orders/{{order_id}}" }, "status": "Unprocessable Entity", "code": 422, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"message\": \"The given data was invalid.\",\n  \"errors\": {\n    \"order\": [\"Orders with payment attempts cannot be deleted.\"]\n  }\n}" }]
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Simulate failed payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{$guid}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"method\": \"credit_card\",\n  \"simulate_outcome\": \"failure\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/orders/{{order_id}}/payments",
            "description": "Run after Confirm order. A failed attempt remains in payment history."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  pm.environment.set('payment_id', pm.response.json().data.id);", "}"] } }],
          "response": [{ "name": "201 failed attempt saved", "originalRequest": { "method": "POST", "url": "{{base_url}}/orders/{{order_id}}/payments" }, "status": "Created", "code": 201, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"data\": {\n    \"id\": 41,\n    \"order_id\": 17,\n    \"status\": \"failed\",\n    \"method\": \"credit_card\",\n    \"amount\": \"30.02\",\n    \"currency\": \"USD\",\n    \"result\": {\"code\": \"simulated_decline\", \"message\": \"The simulated gateway declined this attempt.\"}\n  }\n}" }]
        },
        {
          "name": "Retry after failure (success)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{$guid}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"method\": \"paypal\",\n  \"simulate_outcome\": \"success\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/orders/{{order_id}}/payments"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  pm.environment.set('payment_id', pm.response.json().data.id);", "}"] } }],
          "response": []
        },
        {
          "name": "Unsupported gateway (422 example)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{$guid}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"method\": \"not_a_gateway\",\n  \"simulate_outcome\": \"success\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/orders/{{order_id}}/payments"
          },
          "response": [{ "name": "422 unsupported method", "originalRequest": { "method": "POST", "url": "{{base_url}}/orders/{{order_id}}/payments" }, "status": "Unprocessable Entity", "code": 422, "_postman_previewlanguage": "json", "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [], "body": "{\n  \"message\": \"The given data was invalid.\",\n  \"errors\": {\n    \"method\": [\"The selected payment method is not supported.\"]\n  }\n}" }]
        },
        {
          "name": "List my payments",
          "request": { "method": "GET", "url": "{{base_url}}/payments?per_page=15" },
          "response": []
        },
        {
          "name": "Get payment",
          "request": { "method": "GET", "url": "{{base_url}}/payments/{{payment_id}}" },
          "response": []
        },
        {
          "name": "List payments for order",
          "request": { "method": "GET", "url": "{{base_url}}/orders/{{order_id}}/payments" },
          "response": []
        },
        {
          "name": "Get payment for order",
          "request": { "method": "GET", "url": "{{base_url}}/orders/{{order_id}}/payments/{{payment_id}}" },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "token", "value": "" }
  ]
}
